# .env.example — Kerno Compliance Copilot
#
# Copy this file to .env and fill in real values before running the application.
# Never commit .env — it is excluded by .gitignore.
#
# ──────────────────────────────────────────────────────────────────────────────
# DEV SETUP (one-time, local PostgreSQL)
# ──────────────────────────────────────────────────────────────────────────────
#
# 1. Install PostgreSQL if not already installed:
#    Windows:  winget install PostgreSQL.PostgreSQL
#    Mac:      brew install postgresql && brew services start postgresql
#    Linux:    sudo apt install postgresql && sudo systemctl start postgresql
#
# 2. Create the database and user (run in psql):
#
#    CREATE USER kerno_dev WITH PASSWORD 'kerno_dev';
#    CREATE DATABASE kerno_dev OWNER kerno_dev;
#    GRANT ALL PRIVILEGES ON DATABASE kerno_dev TO kerno_dev;
#
# 3. Copy this file and install dependencies:
#
#    cp .env.example .env
#    pip install -e ".[dev]"
#
# 4. Run migrations:
#
#    alembic upgrade head
#
# 5. Seed dev login credentials (admin@kerno.local / changeme123) plus one user
#    per RBAC role ({role}@kerno.local / $DEV_SEED_PASSWORD, see below):
#
#    PYTHONPATH=. python scripts/seed_dev_tenant.py
#
# 6. Generate a JWT secret and paste it into .env:
#
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 7. Start the server:
#
#    uvicorn src.api.app:app --reload --port 8000
#
# 8. Start the Next.js dashboard and open http://localhost:3000/login
#
#    cd frontend && npm run dev
#
#    Organisation: dev-tenant     <- required since KER-408: an email is unique
#                                    only within one organisation, so it alone
#                                    does not identify an account
#    Email:        admin@kerno.local
#    Password:     changeme123
#
#    The legacy static dashboard at http://localhost:8000/dashboard/login.html
#    is still available in development, but it is frozen — it keeps its JWT in
#    localStorage, and it 404s entirely unless KERNO_ENV=development.
#
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string — matches the user/database created in step 2 above
DATABASE_URL=postgresql://kerno_dev:kerno_dev@localhost:5432/kerno_dev

# URL for the external embedding model API
EMBEDDING_API_URL=https://your-embedding-api.example.com/v1/embeddings

# API key for the embedding model service
EMBEDDING_API_KEY=your-embedding-api-key-here

# Runtime environment — must be one of: development, staging, production
# Three separate controls gate on this being exactly 'development':
#   1. scripts/seed_dev_tenant.py and scripts/seed_demo_evidence.py refuse to run
#      against any other environment (SEC-02).
#   2. The legacy static dashboard at /dashboard/ is only mounted in development.
#   3. The interactive API docs — /docs, /redoc AND /openapi.json — are only
#      served in development. Outside it they 404: the schema publishes every
#      route, every request/response model, and the endpoint docstrings that
#      describe our own authentication design.
# Anything other than 'development', including unset, locks all three down.
# Never set KERNO_ENV=development in a staging or production deployment — one
# edit would re-open all three at once.
KERNO_ENV=development

# Password for the per-role dev users seeded by scripts/seed_dev_tenant.py (KER-202).
# The seed script creates one login per RBAC role — compliance_lead@kerno.local,
# security_engineer@kerno.local, vciso@kerno.local, auditor@kerno.local,
# platform_engineer@kerno.local, end_customer_admin@kerno.local — all using this
# password. If unset, per-role user seeding is skipped. Dev-only; change freely.
DEV_SEED_PASSWORD=changeme-dev-only

# HS256 secret for signing and verifying JWTs — generate with step 6 above
KERNO_JWT_SECRET=generate-with-python-secrets-token-hex-32

# Cross-origin allow-list for the Next.js dashboard (KER-301): comma-separated
# origins. Local dev needs the Next.js dev server; production needs the Vercel
# preview and production domains. Empty/unset = CORS disabled (fails closed).
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# Where GET / sends a browser that hits the bare API root — the Next.js app.
#
# DIRECTION MATTERS, and this is the easy mistake: FRONTEND_URL is where the
# BROWSER goes; KERNO_API_URL below is where the Next.js SERVER goes (this
# backend). They point in opposite directions and are not interchangeable.
# Setting FRONTEND_URL to this backend's own URL makes / redirect to itself
# forever.
#
# Must be an absolute http:// or https:// URL. If it is unset, blank, or not
# absolute, the root falls back to the first ALLOWED_ORIGINS entry; if that is
# also unavailable the root returns a small JSON service descriptor instead of
# redirecting. Relying on the ALLOWED_ORIGINS fallback is not recommended —
# that list is an unordered CORS allow-list, so adding a preview domain at the
# front would silently repoint the production front door.
FRONTEND_URL=http://localhost:3000

# Base URL of this FastAPI backend as seen by the Next.js SERVER (KER-301).
# Lives in frontend/.env.local in practice; documented here as the single
# reference. Server-side only — never NEXT_PUBLIC_*: the browser must never
# call FastAPI directly (the JWT lives in an httpOnly cookie that only
# Next.js route handlers and server components hold).
KERNO_API_URL=http://localhost:8000

# Mistral AI (EU-native LLM provider — https://console.mistral.ai)
# Replaces OpenAI. Mistral AI SAS is incorporated in France with no US-jurisdiction exposure.
MISTRAL_API_KEY=your_key_here
KERNO_LLM_MODEL=mistral-large-latest

# Jira connection for remediation task routing (KER-110)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=your_jira_token_here
JIRA_PROJECT_KEY=KERNO

# Version stamp embedded in evidence pack exports (KER-111)
KERNO_VERSION=dev

# Logging verbosity (optional — defaults to INFO)
LOG_LEVEL=INFO
